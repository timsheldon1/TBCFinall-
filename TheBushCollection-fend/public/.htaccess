# Security Headers
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-WiyTivtvOm3tOqXnL4WauHt1oggl/bGQ5Fh7btGbwGQ=' https://www.googletagmanager.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: https://www.googletagmanager.com; connect-src 'self' https://thebushcollection.onrender.com https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com; frame-src https://www.googletagmanager.com https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'"

# www -> non-www canonical redirect, then React SPA — serve index.html for all routes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force non-www so Google doesn't index www and non-www as duplicate pages
  RewriteCond %{HTTP_HOST} ^www\.thebushcollection\.africa$ [NC]
  RewriteRule ^(.*)$ https://thebushcollection.africa/$1 [L,R=301]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# GZip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/xhtml+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>
